<?xml version="1.0"?>
<robot name="lumos1_rockerless_URDF" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <gazebo>
    <self_collide>false</self_collide>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>joint_lf</left_joint>
      <left_joint>joint_lb</left_joint>
      <right_joint>joint_rf</right_joint>
      <right_joint>joint_rb</right_joint>
      <wheel_separation>0.2522</wheel_separation>
      <wheel_radius>0.08</wheel_radius>
      <topic>/model/lumos/cmd_vel</topic>
      <odom_topic>/model/lumos/odometry</odom_topic>
      <tf_topic>/model/lumos/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <min_linear_velocity>-0.3</min_linear_velocity>
      <max_linear_velocity>0.3</max_linear_velocity>
      <min_linear_acceleration>-0.2</min_linear_acceleration>
      <max_linear_acceleration>0.2</max_linear_acceleration>
      <min_angular_velocity>-1</min_angular_velocity>
      <max_angular_velocity>1</max_angular_velocity>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/lumos/joint_state</topic>
      <joint_name>joint_rf</joint_name>
      <joint_name>joint_rb</joint_name>
      <joint_name>joint_lf</joint_name>
      <joint_name>joint_lb</joint_name>
    </plugin>
  </gazebo>
  <xacro:macro name="wheel_surface" params="link">
    <gazebo reference="${link}">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <selfCollide>false</selfCollide>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_surface link="tire_rf_1"/>
  <xacro:wheel_surface link="tire_rb_1"/>
  <xacro:wheel_surface link="tire_lf_1"/>
  <xacro:wheel_surface link="tire_lb_1"/>
</robot>
