    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.0936 0.0 -0.062228" rpy="0 0 0"/>
    <geometry>
      <mesh filename="$(arg mesh_directory)/rocker_R_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="joint_rf" type="continuous">
  <origin xyz="-0.019 -0.125 -0.072169" rpy="0 0 0"/>
  <parent link="rocker_R_1"/>
  <child link="tire_rf_1"/>
  <axis xyz="1.0 0.0 0.0"/>
  <limit effort="0.5" velocity="8.0"/>
  <dynamics damping="0.002" friction="0.0"/>
</joint>

<joint name="joint_rb" type="continuous">
  <origin xyz="-0.019 0.125 -0.072169" rpy="0 0 0"/>
  <parent link="rocker_R_1"/>
  <child link="tire_rb_1"/>
  <axis xyz="1.0 0.0 0.0"/>
  <limit effort="0.5" velocity="8.0"/>
  <dynamics damping="0.002" friction="0.0"/>
</joint>

<joint name="joint_lb" type="continuous">
  <origin xyz="0.019 0.125 -0.072169" rpy="0 0 0"/>
  <parent link="rocker_L_1"/>
  <child link="tire_lb_1"/>
  <axis xyz="1.0 0.0 0.0"/>
  <limit effort="0.5" velocity="8.0"/>
  <dynamics damping="0.002" friction="0.0"/>
</joint>

<joint name="joint_lf" type="continuous">
  <origin xyz="0.019 -0.125 -0.072169" rpy="0 0 0"/>
  <parent link="rocker_L_1"/>
  <child link="tire_lf_1"/>
  <axis xyz="1.0 0.0 0.0"/>
  <limit effort="0.5" velocity="8.0"/>
  <dynamics damping="0.002" friction="0.0"/>
</joint>

<joint name="joint_rocker_l" type="fixed">
  <origin xyz="0.0936 0.0 0.062228" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="rocker_L_1"/>
</joint>

<joint name="joint_rocker_r" type="fixed">
  <origin xyz="-0.0936 0.0 0.062228" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="rocker_R_1"/>
</joint>

</robot>
