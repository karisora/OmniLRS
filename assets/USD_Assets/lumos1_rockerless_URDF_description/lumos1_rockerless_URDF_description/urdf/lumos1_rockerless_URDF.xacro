<?xml version="1.0" ?>
<robot name="lumos1_rockerless_URDF" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Override mesh_directory with a file:// URI for standalone generation. -->
<xacro:arg name="mesh_directory" default="package://lumos1_rockerless_URDF_description/meshes"/>
<xacro:include filename="materials.xacro" />
<xacro:include filename="lumos1_rockerless_URDF.gazebo" />
<xacro:include filename="stereo_camera.xacro" />
<!-- CAD forward is -Y. Rotate into ROS +X forward, +Y left, +Z up.
     The footprint lies at the bottom of the nominal 80 mm wheels. -->
<link name="base_footprint"/>
<joint name="base_footprint_joint" type="fixed">
  <parent link="base_footprint"/>
  <child link="base_link"/>
  <origin xyz="0 0 0.089941" rpy="0 0 1.5707963267948966"/>
</joint>
<link name="base_link">
  <inertial>
    <origin xyz="1.4209766093905305e-12 0.0007072894827953843 0.07585772026278519" rpy="0 0 0"/>
    <mass value="2.2954656039441095"/>
    <inertia ixx="0.009471" iyy="0.007188" izz="0.016369" ixy="-0.0" iyz="1.7e-05" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="$(arg mesh_directory)/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="$(arg mesh_directory)/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="tire_rf_1">
  <inertial>
    <origin xyz="-0.016311940651014434 -2.9017535874142908e-09 -4.964814926410564e-05" rpy="0 0 0"/>
    <mass value="0.2702287984751716"/>
    <inertia ixx="0.000947" iyy="0.000482" izz="0.000481" ixy="-0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.1126 0.125 0.009941" rpy="0 0 0"/>
    <geometry>
      <mesh filename="$(arg mesh_directory)/tire_rf_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <!-- Smooth primitive contact avoids convex-hulling the 160k-triangle tread. -->
  <collision>
    <origin xyz="-0.0135 0 0" rpy="0 1.5707963267948966 0"/>
    <geometry><cylinder radius="0.08" length="0.027"/></geometry>
  </collision>
</link>

<link name="tire_rb_1">
  <inertial>
    <origin xyz="-0.016311940651014434 -2.901752990669415e-09 -4.964814926410564e-05" rpy="0 0 0"/>
    <mass value="0.2702287984751716"/>
    <inertia ixx="0.000947" iyy="0.000482" izz="0.000481" ixy="-0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.1126 -0.125 0.009941" rpy="0 0 0"/>
    <geometry>
      <mesh filename="$(arg mesh_directory)/tire_rb_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <!-- Smooth primitive contact avoids convex-hulling the 160k-triangle tread. -->
  <collision>
    <origin xyz="-0.0135 0 0" rpy="0 1.5707963267948966 0"/>
    <geometry><cylinder radius="0.08" length="0.027"/></geometry>
  </collision>
</link>

<link name="tire_lb_1">
  <inertial>
    <origin xyz="0.01631194065101438 2.9017532543473834e-09 -4.964814926422187e-05" rpy="0 0 0"/>
    <mass value="0.2702287984751716"/>
    <inertia ixx="0.000947" iyy="0.000482" izz="0.000481" ixy="-0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.1126 -0.125 0.009941" rpy="0 0 0"/>
    <geometry>
      <mesh filename="$(arg mesh_directory)/tire_lb_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <!-- Smooth primitive contact avoids convex-hulling the 160k-triangle tread. -->
  <collision>
    <origin xyz="0.0135 0 0" rpy="0 1.5707963267948966 0"/>
    <geometry><cylinder radius="0.08" length="0.027"/></geometry>
  </collision>
</link>

<link name="tire_lf_1">
  <inertial>
    <origin xyz="0.01631194065101438 2.9017532543473834e-09 -4.964814926422534e-05" rpy="0 0 0"/>
    <mass value="0.2702287984751716"/>
    <inertia ixx="0.000947" iyy="0.000482" izz="0.000481" ixy="-0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.1126 0.125 0.009941" rpy="0 0 0"/>
    <geometry>
      <mesh filename="$(arg mesh_directory)/tire_lf_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <!-- Smooth primitive contact avoids convex-hulling the 160k-triangle tread. -->
  <collision>
    <origin xyz="0.0135 0 0" rpy="0 1.5707963267948966 0"/>
    <geometry><cylinder radius="0.08" length="0.027"/></geometry>
  </collision>
</link>

<link name="rocker_L_1">
  <inertial>
    <origin xyz="-0.00206339111366248 1.2270970182147462e-06 -0.04808465960892697" rpy="0 0 0"/>
    <mass value="0.21047493788773886"/>
    <inertia ixx="0.00257" iyy="0.000322" izz="0.002451" ixy="-0.0" iyz="-0.0" ixz="-7.6e-05"/>
  </inertial>
  <visual>
    <origin xyz="-0.0936 0.0 -0.062228" rpy="0 0 0"/>
    <geometry>
      <mesh filename="$(arg mesh_directory)/rocker_L_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.0936 0.0 -0.062228" rpy="0 0 0"/>
    <geometry>
      <mesh filename="$(arg mesh_directory)/rocker_L_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="rocker_R_1">
  <inertial>
    <origin xyz="0.0020633911136624244 -1.227097018188722e-06 -0.0480846596089268" rpy="0 0 0"/>
    <mass value="0.21047493788773963"/>
    <inertia ixx="0.00257" iyy="0.000322" izz="0.002451" ixy="-0.0" iyz="0.0" ixz="7.6e-05"/>
  </inertial>
  <visual>
    <origin xyz="0.0936 0.0 -0.062228" rpy="0 0 0"/>
